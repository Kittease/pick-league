{
  "name": "pick-league",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "check": "biome check .",
    "format": "biome check --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "db:migrate": "bun run --filter @pick-league/db migrate",
    "db:test:up": "bash scripts/db-test-up.sh",
    "db:test:down": "docker rm -f pick-league-test-db",
    "dev:worker": "bun run --filter @pick-league/worker dev",
    "dev:api": "bun run --filter @pick-league/api dev",
    "dev:desktop": "bun run --filter @pick-league/desktop dev",
    "build:desktop": "bun run --filter @pick-league/desktop build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
