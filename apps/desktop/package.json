{
  "name": "@pick-league/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "PickLeague champion-select helper",
  "main": "./out/main/index.js",
  "scripts": {
    "electron:install": "install-electron",
    "dev": "install-electron && electron-vite dev",
    "dev:mock": "install-electron && PICKLEAGUE_MOCK_LCU=1 electron-vite dev",
    "build": "electron-vite build",
    "start": "install-electron && electron-vite preview",
    "fake-api": "bun run scripts/fake-api.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@pick-league/shared": "workspace:*",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.72.0",
    "next-themes": "0.4.6",
    "shadcn": "4.23.0",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.1",
    "electron-vite": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "vite": "8.3.8"
  }
}
