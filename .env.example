# Riot Games API key (https://developer.riotgames.com). Only the worker reads it.
RIOT_API_KEY=RGAPI-00000000-0000-0000-0000-000000000000

# Postgres password used by docker compose (change it on a VPS).
POSTGRES_PASSWORD=pickleague

# Platforms crawled by the worker (comma-separated: KR,EUW1,NA1,VN2).
PLATFORMS=KR,EUW1,NA1,VN2

# debug | info | warn | error
LOG_LEVEL=info
# Keep collecting the previous patch after the new one is live (backfill by hand; normally unset).
# COLLECT_PREVIOUS_PATCH=true
# Listing skip rule: a tracked player whose new games are all stored already (found through the
# other players of those games) is not asked for their match ids. off (default) | shadow (the rule
# is evaluated and what it would have missed is recorded in listing_skip_misses, but every listing
# still runs) | on.
# LISTING_SKIP=shadow
# Ceiling of the Diamond players tracked per platform (default 0: none, Diamond is not read). How
# many are tracked under it is sized by the worker from the Riot budget the Master+ players leave:
# +500 after a full day of keeping up, -500 after six hours of not keeping up. Each newly tracked
# player's matches of the patch are fetched: the ceiling is there for the disk.
# DIAMOND_MAX_TRACKED=5000
# The Masters outside Riot's list (it stops at 10,000 players) are followed by asking for each
# one's own solo queue entry, in rotation, on the platform host (3,000 requests an hour per
# server, shared with the ladder lists, the Diamond pages, masteries and enrichment). This is the
# most checks per hour and per server (default 1500; 0: those players are not followed): more
# checks means each player is checked more often, and fewer masteries and ranks of new players.
# OUTSIDE_MASTER_CHECKS_PER_HOUR=1500
# Masteries of a tracked player are fetched again after this many days (default 3), and at once
# after their first stored game on a champion.
# MASTERY_REFRESH_DAYS=3

# Only for running apps outside Docker (bun run dev:*), against the dockerised Postgres
# published on localhost (see docker-compose.override.example.yml).
DATABASE_URL=postgres://pickleague:pickleague@localhost:5432/pickleague

# Optional: integration tests of @pick-league/db (bun run db:test:up prints the value).
# DATABASE_URL_TEST=postgres://postgres:postgres@localhost:55432/pickleague_test

# Public address served by Caddy (the VPS IPv4, or a domain later). Unset = localhost.
# PUBLIC_HOST=203.0.113.10

# Optional: token of the gateway (the web app's server) in front of the API. When set, every
# API route but /health needs `Authorization: Bearer <API_TOKEN>`, and the per-IP rate limit
# keys on the visitor IP the gateway sends in `X-Client-IP`. Unset = no auth (local dev).
# Generate one with: openssl rand -hex 32
# API_TOKEN=
