# Riot Games API key (https://developer.riotgames.com). Only the worker reads it.
RIOT_API_KEY=RGAPI-00000000-0000-0000-0000-000000000000

# Postgres password used by docker compose (change it on a VPS).
POSTGRES_PASSWORD=pickleague

# Platforms crawled by the worker (comma-separated: KR,EUW1,NA1,VN2).
PLATFORMS=KR,EUW1,NA1,VN2

# Master players tracked besides Challenger + Grandmaster: the top N by LP (0 = none).
# Raise it for more data on the current patch.
MASTER_PLAYERS=5000

# debug | info | warn | error
LOG_LEVEL=info

# Only for running apps outside Docker (bun run dev:*), against the dockerised Postgres
# published on localhost (see docker-compose.override.example.yml).
DATABASE_URL=postgres://pickleague:pickleague@localhost:5432/pickleague

# Optional: integration tests of @pick-league/db (bun run db:test:up prints the value).
# DATABASE_URL_TEST=postgres://postgres:postgres@localhost:55432/pickleague_test
